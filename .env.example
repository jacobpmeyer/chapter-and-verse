POSTGRES_USER=library_rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=library_rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://library_rag:change-me@localhost:5432/library_rag

# --- Library ---
LIBRARY_PATH=~/Calibre Library

# --- Anthropic (Phases 2 & 4) ---
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-sonnet-5-5
SUMMARY_EFFORT=medium
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
AGENT_MAX_TURNS=12
AGENT_THINKING_DISPLAY=summarized

# --- Embeddings (Phase 3) ---
EMBED_PROVIDER=voyage
VOYAGE_API_KEY=
# OPENAI_API_KEY=
EMBED_MODEL=voyage-4-large
EMBED_DIM=1024

# --- Chunking (estimated tokens) ---
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=80

# --- Agent tool limits ---
FULL_BOOK_TOKEN_LIMIT=150000
WEAK_MATCH_THRESHOLD=0.2

# --- Backups (python index.py backup) ---
BACKUP_DIR=~/Backups/chapter-and-verse

# --- HTTP API (python api.py / docker compose) ---
# Comma-separated keys; give each client its own so it can be revoked.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# AUTH_DISABLED=1          # local development only: no key required
DAILY_BUDGET_USD=5         # /ask and indexing return 429 once today's spend reaches this
CORS_ORIGINS=              # comma-separated origins allowed to call the API from a browser
API_PORT=8080
DB_POOL_MAX=10             # connections per API process (Cloud Run uses 4: Cloud SQL's smallest tier allows ~25)
# Where indexing jobs run: thread (a background thread, local) or cloud_run (a Cloud Run
# Job execution per job, deployed; CLOUD_RUN_JOB=projects/<project>/locations/<region>/jobs/<job>)
JOB_RUNNER=thread
# CLOUD_RUN_JOB=
# Behind Cloudflare Access (deployed): every request except /health must carry a valid
# Access JWT, in addition to an API key. Leave unset locally.
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<the Access application's AUD tag>
